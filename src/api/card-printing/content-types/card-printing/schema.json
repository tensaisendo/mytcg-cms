{
  "kind": "collectionType",
  "collectionName": "card_printings",
  "info": {
    "singularName": "card-printing",
    "pluralName": "card-printings",
    "displayName": "Card Printing"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "printingId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "language": {
      "type": "enumeration",
      "enum": [
        "FR",
        "EN",
        "JP"
      ],
      "required": true,
      "default": "FR"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "cardId": {
      "type": "string",
      "required": true
    },
    "displayCode": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "distribution": {
      "type": "string"
    },
    "acquisition": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "distributionRegion": {
      "type": "string"
    },
    "distributionSourceUrl": {
      "type": "string"
    },
    "distributionVerifiedAt": {
      "type": "datetime"
    },
    "slug": {
      "type": "uid",
      "targetField": "printingId"
    },
    "effect": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "price": {
      "type": "decimal"
    },
    "priceCurrency": {
      "type": "enumeration",
      "enum": [
        "EUR"
      ],
      "default": "EUR"
    },
    "priceSource": {
      "type": "enumeration",
      "enum": [
        "CardTrader",
        "Cardmarket",
        "eBay"
      ]
    },
    "priceUpdatedAt": {
      "type": "datetime"
    },
    "priceSampleSize": {
      "type": "integer",
      "min": 0
    },
    "priceScope": {
      "type": "enumeration",
      "enum": [
        "FR",
        "EU"
      ]
    },
    "priceMethod": {
      "type": "enumeration",
      "enum": [
        "median_lowest_listings",
        "cardmarket_trend",
        "median_market_listings",
        "median_sold_listings"
      ]
    },
    "priceCondition": {
      "type": "enumeration",
      "enum": [
        "Ungraded",
        "Near Mint",
        "Excellent",
        "Good",
        "Light Played",
        "Played",
        "Poor",
        "Graded"
      ]
    },
    "priceSourceUrl": {
      "type": "string"
    },
    "cardTraderBlueprintId": {
      "type": "string"
    },
    "set": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::set.set"
    },
    "card": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::card.card"
    },
    "treatment": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::treatment.treatment"
    }
  }
}
