{
  "kind": "collectionType",
  "collectionName": "user_profiles",
  "info": {
    "singularName": "user-profile",
    "pluralName": "user-profiles",
    "displayName": "User Profile"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "owner": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "avatarData": {
      "type": "text",
      "private": true
    },
    "berries": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "rewardKeys": {
      "type": "json",
      "private": true
    },
    "lastDailyReward": {
      "type": "date",
      "private": true
    }
  }
}
